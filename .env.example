# Geospatial File Measurement API Configuration
# Copy this file to .env and adjust variables as needed

# Database Connection (Default: SQLite with WAL mode, PostgreSQL supported)
DATABASE_URL=sqlite:///./geomeasure.db

# Storage Directories
UPLOAD_DIR=./uploads

# Upload Limits & Zip Security Defenses
MAX_UPLOAD_MB=50
MAX_UNCOMPRESSED_MB=250
MAX_ZIP_ENTRIES=250
MAX_COMPRESSION_RATIO=50.0

# Geospatial & Measurement Tuning
# Tolerance in percent for flagging deviation between projected and geodesic measurements
GEODESIC_TOLERANCE_PCT=0.5

# Pagination Settings
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000

# Logging & Environment
LOG_LEVEL=INFO
ENVIRONMENT=development

# CORS Configuration (comma-separated origins or * for all)
CORS_ORIGINS=*

# Async background processing mode support (?async=true)
ENABLE_ASYNC_MODE=true
